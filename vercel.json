{
  "buildCommand": "npm test",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/favicon.svg"
    }
  ],
  "redirects": [
    {
      "source": "/about",
      "destination": "/mission",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/mission",
      "permanent": true
    },
    {
      "source": "/how-to-read",
      "destination": "/mission",
      "permanent": true
    },
    {
      "source": "/how-to-read.html",
      "destination": "/mission",
      "permanent": true
    },
    {
      "source": "/how-to-read-faster",
      "destination": "/mission",
      "permanent": true
    },
    {
      "source": "/how-to-read-faster.html",
      "destination": "/mission",
      "permanent": true
    }
  ]
}
