      "order": 3
    },
    {
      "id": "body",
      "name": "The Body",
      "description": "Medicine, diet, the gut, fasting, cold and breath: the protocols people use on themselves.",
      "order": 4
    },
    {
      "id": "state",
      "name": "The State",
      "description": "States, elites, war, capture, and the stories institutions tell after they have already decided.",
      "order": 5
    },
    {
      "id": "past",
      "name": "The Past",
      "description": "What actually happened: wars, empires, and lives, and why they went the way they did.",
      "order": 6
    },
    {
      "id": "self",
      "name": "The Self",
